# Export variables in your shell before running Go; .env is not loaded automatically.
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://aerosync:aerosync_local@localhost:5432/aerosync?sslmode=disable
# Exact browser origin, without a trailing slash. Production must use HTTPS.
APP_ORIGIN=http://localhost:5173
# Defaults to true. false is accepted only for a localhost APP_ORIGIN.
COOKIE_SECURE=false
