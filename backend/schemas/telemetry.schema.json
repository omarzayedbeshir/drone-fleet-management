{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AeroSync normalized telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source",
    "observed_at",
    "status",
    "flight_time_seconds",
    "battery_cycles",
    "fault_flags"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source": {
      "enum": [
        "dji",
        "ardupilot",
        "csv"
      ],
      "description": "Normalized source identity. csv is a testing/fallback format, not a supported drone vendor."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 instant; input offsets are accepted, normalized to UTC and microsecond precision. Runtime rejects times before 1970 or more than five minutes in the future."
    },
    "status": {
      "enum": [
        "available",
        "charging",
        "in_mission",
        "grounded",
        "unknown"
      ]
    },
    "flight_time_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Nonnegative cumulative lifetime flight seconds, not a per-message increment.",
      "x-unit": "s"
    },
    "battery_cycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Nonnegative cumulative drone battery cycles, not an individual battery lifecycle record.",
      "x-unit": "count"
    },
    "fault_flags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_:-]{1,64}$"
      },
      "description": "Explicit fault codes; empty array means none. The server sorts and deduplicates entries."
    },
    "battery_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Battery state of charge; null when unavailable.",
      "x-unit": "percent"
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90,
      "description": "Latitude; must be numeric together with longitude, or both absent/null.",
      "x-unit": "degree"
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180,
      "description": "Longitude; must be numeric together with latitude, or both absent/null.",
      "x-unit": "degree"
    },
    "altitude_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -12000,
      "maximum": 100000,
      "description": "Metres above mean sea level (MSL); null if the adapter cannot establish the datum.",
      "x-unit": "m"
    },
    "speed_mps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 500,
      "description": "Speed in metres per second.",
      "x-unit": "m/s"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      }
    }
  ]
}
