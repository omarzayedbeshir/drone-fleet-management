{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AeroSync normalized telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source",
    "observed_at",
    "status",
    "flight_time_seconds",
    "battery_cycles",
    "fault_flags"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source": {
      "enum": [
        "dji",
        "ardupilot",
        "csv"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "available",
        "charging",
        "in_mission",
        "grounded",
        "unknown"
      ]
    },
    "flight_time_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "battery_cycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "fault_flags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_:-]{1,64}$"
      }
    },
    "battery_percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "altitude_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -12000,
      "maximum": 100000
    },
    "speed_mps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 500
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "longitude"
        ],
        "properties": {
          "longitude": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "latitude"
        ],
        "properties": {
          "latitude": {
            "type": "number"
          }
        }
      }
    }
  ]
}
